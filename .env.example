# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# GOOGLE_CLIENT_ID & GOOGLE_CLIENT_SECRET: Needed for real Google Sign-In popups.
# Retrieve from Google Cloud Console Credentials page:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Last.fm API key — free, instant signup: https://www.last.fm/api/account/create
# Powers /api/lastfm-artist + /api/lastfm-similar (taste analysis enrichment).
# Optional — endpoints return 505 if not set.
LASTFM_API_KEY=

# YouTube Data API v3 key — the owner's key is BAKED IN to public/api/config.php
# (v6) and used by the embed health checker + stream resolver for the
# authoritative status.embeddable / privacyStatus / regionRestriction signals.
# Set this env var ONLY to override it with your own key (free:
# console.cloud.google.com -> "YouTube Data API v3" -> Credentials -> API key).
YOUTUBE_API_KEY=

# VITE_API_URL — set this in Cloudflare Pages env vars (NOT in server .env).
# Points the frontend at your API origin when frontend + API live on different
# domains (Architecture A). Leave empty for single-box deployments (Architecture C).
# Example: VITE_API_URL=https://api.yourdomain.com
VITE_API_URL=

# FIRESTORE_DATABASE_ID: Optional. The Firestore database ID to use.
# Defaults to the project's "(default)" database. Set this only if your
# Firebase project uses a named database (the AI Studio sandbox does).
# Leave blank in production deployments unless you specifically need a
# non-default database.
FIRESTORE_DATABASE_ID=

# NODE_ENV: Set to "production" for production deployments.
# The Express server uses this to enable tightened CSP headers and serve
# the built Vite assets from /dist.
NODE_ENV=development
